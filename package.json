{
  "name": "dataops-dbt-commander",
  "displayName": "DataOps dbt Commander",
  "description": "Run, build, test, compile and preview dbt models from the VS Code Explorer and editor with dbt-core 1.x from a configured venv.",
  "version": "0.9.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbtCommander.run",
        "title": "dbt Run",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.build",
        "title": "dbt Build",
        "category": "dbt Commander",
        "icon": "$(play)"
      },
      {
        "command": "dbtCommander.test",
        "title": "dbt Test",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.buildUpstream",
        "title": "dbt Build + Upstream",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.buildDownstream",
        "title": "dbt Build + Downstream",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.buildUpDownstream",
        "title": "dbt Build + Upstream & Downstream",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.compile",
        "title": "dbt Compile (show compiled SQL)",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.preview",
        "title": "dbt Preview Data",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.deps",
        "title": "dbt deps",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.seed",
        "title": "dbt seed",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.snapshot",
        "title": "dbt snapshot",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.docsGenerate",
        "title": "dbt docs generate (open static docs)",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.selectTarget",
        "title": "Switch Target",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.menu",
        "title": "Show Menu",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.openSettings",
        "title": "Open Settings",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.seedFiles",
        "title": "dbt Seed",
        "category": "dbt Commander",
        "icon": "$(table)"
      },
      {
        "command": "dbtCommander.generateYaml",
        "title": "dbt Generate YAML",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.parse",
        "title": "dbt parse",
        "category": "dbt Commander",
        "icon": "$(sync)"
      },
      {
        "command": "dbtCommander.refreshSidebar",
        "title": "Refresh",
        "category": "dbt Commander",
        "icon": "$(refresh)"
      },
      {
        "command": "dbtCommander.tree.run",
        "title": "Run",
        "category": "dbt Commander",
        "icon": "$(play)"
      },
      {
        "command": "dbtCommander.tree.build",
        "title": "Build",
        "category": "dbt Commander",
        "icon": "$(run-all)"
      },
      {
        "command": "dbtCommander.tree.test",
        "title": "Test",
        "category": "dbt Commander",
        "icon": "$(beaker)"
      },
      {
        "command": "dbtCommander.tree.seed",
        "title": "Seed",
        "category": "dbt Commander",
        "icon": "$(play)"
      },
      {
        "command": "dbtCommander.tree.snapshot",
        "title": "Snapshot",
        "category": "dbt Commander",
        "icon": "$(play)"
      },
      {
        "command": "dbtCommander.tree.runTest",
        "title": "Run test",
        "category": "dbt Commander",
        "icon": "$(play)"
      },
      {
        "command": "dbtCommander.tree.snapshotAll",
        "title": "Snapshot all",
        "category": "dbt Commander",
        "icon": "$(play)"
      },
      {
        "command": "dbtCommander.showLineage",
        "title": "Show lineage",
        "category": "dbt Commander",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbtCommander.lineage.followEditor",
        "title": "Follow active editor",
        "category": "dbt Commander",
        "icon": "$(link)"
      },
      {
        "command": "dbtCommander.tree.buildUpstream",
        "title": "Build + Upstream",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.tree.buildDownstream",
        "title": "Build + Downstream",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.tree.buildUpDownstream",
        "title": "Build + Upstream & Downstream",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.retry",
        "title": "dbt retry (rerun what failed)",
        "category": "dbt Commander",
        "icon": "$(refresh)"
      },
      {
        "command": "dbtCommander.rerunLast",
        "title": "Rerun last dbt command",
        "category": "dbt Commander",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dbtCommander.renameModel",
        "title": "dbt Rename model…",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.createStaging",
        "title": "dbt Create staging model",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.newModel",
        "title": "dbt New model…",
        "category": "dbt Commander"
      },
      {
        "command": "dbtCommander.openInDocs",
        "title": "Open in dbt docs",
        "category": "dbt Commander",
        "icon": "$(book)"
      },
      {
        "command": "dbtCommander.debug",
        "title": "Check connection (dbt debug)",
        "category": "dbt Commander",
        "icon": "$(plug)"
      }
    ],
    "submenus": [
      {
        "id": "dbtCommander.submenu",
        "label": "dbt"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "dbtCommander.submenu",
          "when": "(resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i) || (explorerResourceIsFolder && resourcePath not =~ /[\\\\/](dbt_packages|target|node_modules|logs|\\.git|\\.venv|venv|\\.vscode|__pycache__)([\\\\/]|$)/i)",
          "group": "navigation@90"
        },
        {
          "command": "dbtCommander.seedFiles",
          "when": "resourceExtname =~ /^\\.csv$/i && (resourcePath =~ /[\\\\/]seeds[\\\\/]/i || resourcePath in dbtCommander.seedPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i",
          "group": "navigation@91"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "dbtCommander.submenu",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        }
      ],
      "editor/title": [
        {
          "command": "dbtCommander.build",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i",
          "group": "navigation@-10"
        },
        {
          "command": "dbtCommander.seedFiles",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.csv$/i && (resourcePath =~ /[\\\\/]seeds[\\\\/]/i || resourcePath in dbtCommander.seedPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i",
          "group": "navigation@-10"
        }
      ],
      "dbtCommander.submenu": [
        {
          "command": "dbtCommander.run",
          "group": "dbt@1",
          "when": "!explorerResourceIsFolder || (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths)"
        },
        {
          "command": "dbtCommander.build",
          "group": "dbt@2"
        },
        {
          "command": "dbtCommander.test",
          "group": "dbt@3",
          "when": "!explorerResourceIsFolder || (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths)"
        },
        {
          "command": "dbtCommander.seedFiles",
          "group": "dbt@4",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.buildUpstream",
          "group": "graph@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.buildDownstream",
          "group": "graph@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.buildUpDownstream",
          "group": "graph@3",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.compile",
          "group": "inspect@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.preview",
          "group": "inspect@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.openSettings",
          "group": "z@1"
        },
        {
          "command": "dbtCommander.generateYaml",
          "group": "inspect@3",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.showLineage",
          "group": "inspect@4",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.renameModel",
          "group": "refactor@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.openInDocs",
          "group": "inspect@5",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtCommander.newModel",
          "group": "refactor@2",
          "when": "explorerResourceIsFolder && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths)"
        }
      ],
      "commandPalette": [
        {
          "command": "dbtCommander.run",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.build",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.test",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.buildUpstream",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.buildDownstream",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.buildUpDownstream",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.compile",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.preview",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.menu",
          "when": "false"
        },
        {
          "command": "dbtCommander.seedFiles",
          "when": "editorIsOpen && resourceExtname =~ /^\\.csv$/i && (resourcePath =~ /[\\\\/]seeds[\\\\/]/i || resourcePath in dbtCommander.seedPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.generateYaml",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.tree.run",
          "when": "false"
        },
        {
          "command": "dbtCommander.tree.build",
          "when": "false"
        },
        {
          "command": "dbtCommander.tree.test",
          "when": "false"
        },
        {
          "command": "dbtCommander.tree.seed",
          "when": "false"
        },
        {
          "command": "dbtCommander.tree.snapshot",
          "when": "false"
        },
        {
          "command": "dbtCommander.tree.runTest",
          "when": "false"
        },
        {
          "command": "dbtCommander.showLineage",
          "when": "editorIsOpen && resourceScheme == file && resourcePath not =~ /[\\\\/](dbt_packages|target)[\\\\/]/i && ((resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/](models|snapshots)[\\\\/]/i || resourcePath in dbtCommander.modelPaths || resourcePath in dbtCommander.snapshotPaths)) || (resourceExtname =~ /^\\.csv$/i && (resourcePath =~ /[\\\\/]seeds[\\\\/]/i || resourcePath in dbtCommander.seedPaths)))"
        },
        {
          "command": "dbtCommander.tree.snapshotAll",
          "when": "false"
        },
        {
          "command": "dbtCommander.lineage.followEditor",
          "when": "dbtCommander.lineagePinned"
        },
        {
          "command": "dbtCommander.tree.buildUpstream",
          "when": "false"
        },
        {
          "command": "dbtCommander.tree.buildDownstream",
          "when": "false"
        },
        {
          "command": "dbtCommander.tree.buildUpDownstream",
          "when": "false"
        },
        {
          "command": "dbtCommander.renameModel",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.openInDocs",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtCommander.createStaging",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i"
        },
        {
          "command": "dbtCommander.newModel",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "dbtCommander.refreshSidebar",
          "when": "view == dbtCommander.project",
          "group": "navigation@1"
        },
        {
          "command": "dbtCommander.parse",
          "when": "view == dbtCommander.project",
          "group": "navigation@2"
        },
        {
          "command": "dbtCommander.lineage.followEditor",
          "when": "view == dbtCommander.lineage && dbtCommander.lineagePinned",
          "group": "navigation@1"
        },
        {
          "command": "dbtCommander.retry",
          "when": "view == dbtCommander.lastRun && dbtCommander.lastRunFailed",
          "group": "navigation@1"
        },
        {
          "command": "dbtCommander.rerunLast",
          "when": "view == dbtCommander.lastRun",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dbtCommander.tree.run",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models)$/",
          "group": "inline@1"
        },
        {
          "command": "dbtCommander.tree.seed",
          "when": "view == dbtCommander.project && viewItem =~ /^(seed|seedFolder|section-seeds|project)$/",
          "group": "inline@1"
        },
        {
          "command": "dbtCommander.tree.build",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models|seed|seedFolder|section-seeds|project)$/",
          "group": "inline@2"
        },
        {
          "command": "dbtCommander.tree.test",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models)$/",
          "group": "inline@3"
        },
        {
          "command": "dbtCommander.tree.snapshot",
          "when": "view == dbtCommander.project && viewItem == snapshot",
          "group": "inline@1"
        },
        {
          "command": "dbtCommander.tree.snapshotAll",
          "when": "view == dbtCommander.project && viewItem == section-snapshots",
          "group": "inline@1"
        },
        {
          "command": "dbtCommander.tree.runTest",
          "when": "view == dbtCommander.project && viewItem == test",
          "group": "inline@1"
        },
        {
          "command": "dbtCommander.showLineage",
          "when": "view == dbtCommander.project && viewItem == model",
          "group": "model@0"
        },
        {
          "command": "dbtCommander.compile",
          "when": "view == dbtCommander.project && viewItem == model",
          "group": "model@1"
        },
        {
          "command": "dbtCommander.preview",
          "when": "view == dbtCommander.project && viewItem == model",
          "group": "model@2"
        },
        {
          "command": "dbtCommander.generateYaml",
          "when": "view == dbtCommander.project && viewItem == model",
          "group": "model@3"
        },
        {
          "command": "dbtCommander.tree.build",
          "when": "view == dbtCommander.lineage && viewItem == lineage-model",
          "group": "inline@1"
        },
        {
          "command": "dbtCommander.tree.seed",
          "when": "view == dbtCommander.lineage && viewItem == lineage-seed",
          "group": "inline@1"
        },
        {
          "command": "dbtCommander.tree.run",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models)$/",
          "group": "0_dbt@1"
        },
        {
          "command": "dbtCommander.tree.build",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models|seed|seedFolder|section-seeds|project)$/",
          "group": "0_dbt@2"
        },
        {
          "command": "dbtCommander.tree.test",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models|seed|seedFolder|section-seeds)$/",
          "group": "0_dbt@3"
        },
        {
          "command": "dbtCommander.tree.seed",
          "when": "view == dbtCommander.project && viewItem =~ /^(seed|seedFolder|section-seeds|project)$/",
          "group": "0_dbt@4"
        },
        {
          "command": "dbtCommander.tree.snapshot",
          "when": "view == dbtCommander.project && viewItem == snapshot",
          "group": "0_dbt@5"
        },
        {
          "command": "dbtCommander.tree.runTest",
          "when": "view == dbtCommander.project && viewItem == test",
          "group": "0_dbt@6"
        },
        {
          "command": "dbtCommander.tree.buildUpstream",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models|seed|seedFolder|section-seeds)$/",
          "group": "1_graph@1"
        },
        {
          "command": "dbtCommander.tree.buildDownstream",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models|seed|seedFolder|section-seeds)$/",
          "group": "1_graph@2"
        },
        {
          "command": "dbtCommander.tree.buildUpDownstream",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|modelFolder|section-models|seed|seedFolder|section-seeds)$/",
          "group": "1_graph@3"
        },
        {
          "command": "dbtCommander.renameModel",
          "when": "view == dbtCommander.project && viewItem == model",
          "group": "refactor@1"
        },
        {
          "command": "dbtCommander.newModel",
          "when": "view == dbtCommander.project && viewItem =~ /^(modelFolder|section-models)$/",
          "group": "refactor@2"
        },
        {
          "command": "dbtCommander.createStaging",
          "when": "view == dbtCommander.project && viewItem == sourceTable",
          "group": "refactor@3"
        },
        {
          "command": "dbtCommander.openInDocs",
          "when": "view == dbtCommander.project && viewItem =~ /^(model|seed|snapshot|sourceTable|exposure|semanticModel)$/",
          "group": "model@4"
        },
        {
          "command": "dbtCommander.openInDocs",
          "when": "view == dbtCommander.lineage && viewItem =~ /^lineage-/",
          "group": "docs@1"
        },
        {
          "command": "dbtCommander.createStaging",
          "when": "view == dbtCommander.lineage && viewItem =~ /^lineage-source/",
          "group": "docs@2"
        }
      ]
    },
    "configuration": {
      "title": "DataOps dbt Commander",
      "properties": {
        "dbtCommander.venvPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python virtual environment that has dbt-core 1.x installed (the folder containing Scripts\\dbt.exe)."
        },
        "dbtCommander.target": {
          "type": "string",
          "default": "",
          "description": "Optional dbt target passed as --target."
        },
        "dbtCommander.extraArgs": {
          "type": "string",
          "default": "",
          "description": "Extra flags appended to every dbt command except deps, separated by spaces (quotes keep values together)."
        },
        "dbtCommander.previewLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum number of rows returned by dbt Preview Data (dbt show --limit)."
        },
        "dbtCommander.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Run · Build · Test · Compile · Preview links above each dbt model."
        },
        "dbtCommander.openDocsAfterGenerate": {
          "type": "boolean",
          "default": true,
          "description": "Open the static docs page in your browser after dbt docs generate."
        },
        "dbtCommander.notifyAfterSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Show a notification with the results when a dbt command takes at least this many seconds (0 = never)."
        },
        "dbtCommander.newModelTemplate": {
          "type": "string",
          "default": "",
          "description": "Optional template file for \"dbt New model…\" (relative to the dbt project or absolute). {{name}} is replaced with the model name."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "dbtCommander",
        "required": [
          "id"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "id": {
            "type": "number",
            "description": "Unique run id"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "dbtCommander.build",
        "key": "ctrl+' b",
        "mac": "cmd+' b",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtCommander.run",
        "key": "ctrl+' r",
        "mac": "cmd+' r",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtCommander.test",
        "key": "ctrl+' t",
        "mac": "cmd+' t",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtCommander.compile",
        "key": "ctrl+' c",
        "mac": "cmd+' c",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtCommander.preview",
        "key": "ctrl+' p",
        "mac": "cmd+' p",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && (resourcePath =~ /[\\\\/]models([\\\\/]|$)/i || resourcePath in dbtCommander.modelPaths) && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtCommander.rerunLast",
        "key": "ctrl+' l",
        "mac": "cmd+' l"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbtCommander",
          "title": "dbt",
          "icon": "resources/dbt.svg"
        }
      ]
    },
    "views": {
      "dbtCommander": [
        {
          "id": "dbtCommander.project",
          "name": "Project",
          "contextualTitle": "dbt"
        },
        {
          "id": "dbtCommander.lineage",
          "name": "Lineage",
          "contextualTitle": "dbt"
        },
        {
          "id": "dbtCommander.lastRun",
          "name": "Last run",
          "contextualTitle": "dbt"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit -p .",
    "compile": "tsc -p .",
    "watch": "npm run build -- --watch",
    "test": "node --test \"out/test/*.test.js\"",
    "test:integration": "npm run build && node test/integration/run.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.4.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "dbt commands are disabled in untrusted workspaces because dbt executes the project’s macros and hooks. The venv path, target and extra flags are only read from your user settings there.",
      "restrictedConfigurations": [
        "dbtCommander.venvPath",
        "dbtCommander.extraArgs",
        "dbtCommander.target"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/razjir-bote/dataops-dbt-commander.git"
  }
}
