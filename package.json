{
  "name": "dbt-runner",
  "displayName": "dbt Runner",
  "description": "Run, build, test, compile and preview dbt models from the VS Code Explorer and editor with dbt-core 1.x from a configured venv.",
  "version": "0.5.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbtRunner.run",
        "title": "dbt Run",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.build",
        "title": "dbt Build",
        "category": "dbt Runner",
        "icon": "$(play)"
      },
      {
        "command": "dbtRunner.test",
        "title": "dbt Test",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.buildUpstream",
        "title": "dbt Build + Upstream",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.buildDownstream",
        "title": "dbt Build + Downstream",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.buildUpDownstream",
        "title": "dbt Build + Upstream & Downstream",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.compile",
        "title": "dbt Compile (show compiled SQL)",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.preview",
        "title": "dbt Preview Data",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.deps",
        "title": "dbt deps",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.seed",
        "title": "dbt seed",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.snapshot",
        "title": "dbt snapshot",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.docsGenerate",
        "title": "dbt docs generate (open static docs)",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.selectTarget",
        "title": "Switch Target",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.menu",
        "title": "Show Menu",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.openSettings",
        "title": "Open Settings",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.seedFiles",
        "title": "dbt Seed",
        "category": "dbt Runner",
        "icon": "$(table)"
      },
      {
        "command": "dbtRunner.generateYaml",
        "title": "dbt Generate YAML",
        "category": "dbt Runner"
      },
      {
        "command": "dbtRunner.parse",
        "title": "dbt parse",
        "category": "dbt Runner",
        "icon": "$(sync)"
      },
      {
        "command": "dbtRunner.refreshSidebar",
        "title": "Refresh",
        "category": "dbt Runner",
        "icon": "$(refresh)"
      },
      {
        "command": "dbtRunner.tree.run",
        "title": "Run",
        "category": "dbt Runner",
        "icon": "$(play)"
      },
      {
        "command": "dbtRunner.tree.build",
        "title": "Build",
        "category": "dbt Runner",
        "icon": "$(run-all)"
      },
      {
        "command": "dbtRunner.tree.test",
        "title": "Test",
        "category": "dbt Runner",
        "icon": "$(beaker)"
      },
      {
        "command": "dbtRunner.tree.seed",
        "title": "Seed",
        "category": "dbt Runner",
        "icon": "$(play)"
      },
      {
        "command": "dbtRunner.tree.snapshot",
        "title": "Snapshot",
        "category": "dbt Runner",
        "icon": "$(play)"
      },
      {
        "command": "dbtRunner.tree.runTest",
        "title": "Run test",
        "category": "dbt Runner",
        "icon": "$(play)"
      }
    ],
    "submenus": [
      {
        "id": "dbtRunner.submenu",
        "label": "dbt"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "dbtRunner.submenu",
          "when": "(resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i) || (explorerResourceIsFolder && resourcePath not =~ /[\\\\/](dbt_packages|target|node_modules|logs|\\.git|\\.venv|venv|\\.vscode|__pycache__)([\\\\/]|$)/i)",
          "group": "navigation@90"
        },
        {
          "command": "dbtRunner.seedFiles",
          "when": "resourceExtname =~ /^\\.csv$/i && resourcePath =~ /[\\\\/]seeds[\\\\/]/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i",
          "group": "navigation@91"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "dbtRunner.submenu",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        }
      ],
      "editor/title": [
        {
          "command": "dbtRunner.build",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i",
          "group": "navigation@-10"
        },
        {
          "command": "dbtRunner.seedFiles",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.csv$/i && resourcePath =~ /[\\\\/]seeds[\\\\/]/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i",
          "group": "navigation@-10"
        }
      ],
      "dbtRunner.submenu": [
        {
          "command": "dbtRunner.run",
          "group": "dbt@1",
          "when": "!explorerResourceIsFolder || resourcePath =~ /[\\\\/]models([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.build",
          "group": "dbt@2"
        },
        {
          "command": "dbtRunner.test",
          "group": "dbt@3",
          "when": "!explorerResourceIsFolder || resourcePath =~ /[\\\\/]models([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.seedFiles",
          "group": "dbt@4",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "dbtRunner.buildUpstream",
          "group": "graph@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtRunner.buildDownstream",
          "group": "graph@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtRunner.buildUpDownstream",
          "group": "graph@3",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtRunner.compile",
          "group": "inspect@1",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtRunner.preview",
          "group": "inspect@2",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "dbtRunner.openSettings",
          "group": "z@1"
        },
        {
          "command": "dbtRunner.generateYaml",
          "group": "inspect@3",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "dbtRunner.run",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.build",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.test",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.buildUpstream",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.buildDownstream",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.buildUpDownstream",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.compile",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.preview",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.menu",
          "when": "false"
        },
        {
          "command": "dbtRunner.seedFiles",
          "when": "editorIsOpen && resourceExtname =~ /^\\.csv$/i && resourcePath =~ /[\\\\/]seeds[\\\\/]/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.generateYaml",
          "when": "editorIsOpen && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
        },
        {
          "command": "dbtRunner.tree.run",
          "when": "false"
        },
        {
          "command": "dbtRunner.tree.build",
          "when": "false"
        },
        {
          "command": "dbtRunner.tree.test",
          "when": "false"
        },
        {
          "command": "dbtRunner.tree.seed",
          "when": "false"
        },
        {
          "command": "dbtRunner.tree.snapshot",
          "when": "false"
        },
        {
          "command": "dbtRunner.tree.runTest",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "dbtRunner.refreshSidebar",
          "when": "view == dbtRunner.project",
          "group": "navigation@1"
        },
        {
          "command": "dbtRunner.parse",
          "when": "view == dbtRunner.project",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dbtRunner.tree.run",
          "when": "view == dbtRunner.project && viewItem =~ /^(model|modelFolder)$/",
          "group": "inline@1"
        },
        {
          "command": "dbtRunner.tree.build",
          "when": "view == dbtRunner.project && viewItem =~ /^(model|modelFolder)$/",
          "group": "inline@2"
        },
        {
          "command": "dbtRunner.tree.test",
          "when": "view == dbtRunner.project && viewItem =~ /^(model|modelFolder)$/",
          "group": "inline@3"
        },
        {
          "command": "dbtRunner.tree.seed",
          "when": "view == dbtRunner.project && viewItem == seed",
          "group": "inline@1"
        },
        {
          "command": "dbtRunner.tree.snapshot",
          "when": "view == dbtRunner.project && viewItem == snapshot",
          "group": "inline@1"
        },
        {
          "command": "dbtRunner.tree.runTest",
          "when": "view == dbtRunner.project && viewItem == test",
          "group": "inline@1"
        },
        {
          "command": "dbtRunner.compile",
          "when": "view == dbtRunner.project && viewItem == model",
          "group": "model@1"
        },
        {
          "command": "dbtRunner.preview",
          "when": "view == dbtRunner.project && viewItem == model",
          "group": "model@2"
        },
        {
          "command": "dbtRunner.generateYaml",
          "when": "view == dbtRunner.project && viewItem == model",
          "group": "model@3"
        }
      ]
    },
    "configuration": {
      "title": "dbt Runner",
      "properties": {
        "dbtRunner.venvPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python virtual environment that has dbt-core 1.x installed (the folder containing Scripts\\dbt.exe)."
        },
        "dbtRunner.target": {
          "type": "string",
          "default": "",
          "description": "Optional dbt target passed as --target."
        },
        "dbtRunner.extraArgs": {
          "type": "string",
          "default": "",
          "description": "Extra flags appended to every dbt command except deps, separated by spaces (quotes keep values together)."
        },
        "dbtRunner.previewLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum number of rows returned by dbt Preview Data (dbt show --limit)."
        },
        "dbtRunner.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Run · Build · Test · Compile · Preview links above each dbt model."
        },
        "dbtRunner.openDocsAfterGenerate": {
          "type": "boolean",
          "default": true,
          "description": "Open the static docs page in your browser after dbt docs generate."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "dbtRunner",
        "required": [
          "id"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "id": {
            "type": "number",
            "description": "Unique run id"
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "dbtRunner.build",
        "key": "ctrl+' b",
        "mac": "cmd+' b",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtRunner.run",
        "key": "ctrl+' r",
        "mac": "cmd+' r",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtRunner.test",
        "key": "ctrl+' t",
        "mac": "cmd+' t",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtRunner.compile",
        "key": "ctrl+' c",
        "mac": "cmd+' c",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      },
      {
        "command": "dbtRunner.preview",
        "key": "ctrl+' p",
        "mac": "cmd+' p",
        "when": "resourceScheme == file && editorTextFocus && resourceExtname =~ /^\\.sql$/i && resourcePath =~ /[\\\\/]models([\\\\/]|$)/i && resourcePath not =~ /[\\\\/](dbt_packages|target)([\\\\/]|$)/i"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbtRunner",
          "title": "dbt",
          "icon": "resources/dbt.svg"
        }
      ]
    },
    "views": {
      "dbtRunner": [
        {
          "id": "dbtRunner.project",
          "name": "Project",
          "contextualTitle": "dbt"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit -p .",
    "compile": "tsc -p .",
    "watch": "npm run build -- --watch",
    "test": "node --test \"out/test/*.test.js\"",
    "test:integration": "npm run build && node test/integration/run.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.4.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "dbt commands are disabled in untrusted workspaces because dbt executes the project’s macros and hooks. The venv path, target and extra flags are only read from your user settings there.",
      "restrictedConfigurations": [
        "dbtRunner.venvPath",
        "dbtRunner.extraArgs",
        "dbtRunner.target"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/razjir-bote/vscode-dbt-runner.git"
  }
}
